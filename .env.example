# ── 기본값으로 동작합니다. 아래 값은 모두 선택 사항입니다. ──

# 백엔드 선택: graphql(기본) | postgres | file
# BOARD_BACKEND="graphql"

# 코드캠프 실습 백엔드 (기본값이라 지정하지 않아도 됩니다)
# GRAPHQL_ENDPOINT="https://backend-practice.codebootcamp.co.kr/graphql"

# ── BOARD_BACKEND=postgres 로 쓸 때만 필요 ──
# POSTGRES_URL="postgres://user:password@host/db?sslmode=require"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
